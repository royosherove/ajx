#!/usr/bin/env python3
"""ajx: deterministic runner for AJX v1 trials (matrix of harness x model x config x repetition).

Commands:
  init <dir> --product NAME [--harness NAME]   scaffold a trial for your chosen CLI
  example <dir>                   generate fictional reports offline; no agent calls
  docs [TOPIC]                    read bundled setup, reporting, artifact and measurement docs
  doctor [trial.toml]              harness/auth/runner availability; model identity vs task identity;
                                   env overrides and collisions; preflight (no secrets printed)
  validate <trial.toml>            check the trial file, print the run plan, prompt hash and env warnings
  run <trial.toml> [--cells a,b] [--stages s1,s2] [--dry-run] [--keep-workspace] [--no-synthesis]
  status <trial.toml|matrix-dir> [--tail N]   per-run stage table; --tail adds each executing worker's last N events
  report <trial.toml> [--no-synthesis]   re-render run reports and the matrix report
  export <trial.toml|matrix-dir> --run ID [--dest DIR] [--force]   shareable copy of one run: report.html,
                                   journey.html, asks.md with the worker's directories relabeled
  console [open] <trial>           local web page to review, start and watch a trial (background server)
  console demo <dir>               copy a simulated trial (no agent or model) and open it in the console
  console list | stop [--all]      running console servers; stopping one never stops a run
  console since|wait|note|start|again|state <trial>   the coordinating agent's view of the same trial
  plugins                          list registered harness/auth/runner/check plugins

Start with: ajx docs guide   |   Trial syntax: ajx docs trial   |   Checks: ajx docs checks
Public quickstart: https://ajx.dev/agents/
"""

import argparse
import hashlib
import json
import math
import re
import os
import signal
import sys
import tempfile
import threading
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "lib"))

from ajx import __version__, console as consolemod, envcheck, export as exportmod, plugins, render, runner, spec as specmod  # noqa: E402,E501
from ajx.util import parse_ts, read_json  # noqa: E402

TRIAL_TEMPLATE = '''# AJX trial file. Everything the matrix needs, in one place. See examples/trial.toml.
[trial]
id = "{id}"
product = "{product}"
product_version_cmd = ""          # e.g. "mytool --version"; recorded before and after each run
workspace_root = "/tmp"           # fresh unnamed workspace per run is created here (outside the report dir)
repetitions = 1
parallel = 1                      # >1 makes wall-clock incomparable (recorded)
timeout_seconds = 1800
narrate_timeout_seconds = 900     # for the resumed self-narration and reporter calls
# max_budget_usd = 5              # enforced by harnesses that support it (claude-code)
order_seed = 0
cache = "isolated"                # isolated | shared package caches
shell_startup = "inherit"         # skip: the worker's tool shell reads no ~/.zshenv or BASH_ENV (local runs)

[task]
prompt_file = "task-prompt.md"    # exact bytes are hashed; never edited by ajx
materials = []                    # URLs/docs the prompt points the agent to (recorded)
human = "unavailable"             # headless: a required human action is recorded as a Gate
# fixture_dir = "fixture"         # copied into every fresh workspace before setup
# identity_cmd = "aws sts get-caller-identity --profile my-sandbox"   # the account the worker acts in;
                                  # doctor runs it in the worker's own tool shell and fails if it errors

# [env]                           # worker env. Not for credentials the model also uses (Bedrock reads
# MY_VAR = "x"                    # AWS_*): doctor warns on collisions and on values the shell overrides

# [[preflight]]                   # must pass before each worker starts; same env as verify/teardown
# name = "task credentials work"
# run = "aws sts get-caller-identity --profile my-sandbox"

# [[setup]]                       # before the clock; recorded as preinstalled setup
# run = "git init -q"

# [[verify]]                      # deterministic checks run by ajx AFTER the agent stops
# name = "project created"
# type = "file_exists"            # shell | file_exists | http (plugins can add more)
# path = "*/package.json"

# [[teardown]]                    # always runs; $AJX_RUN_TOKEN is available for tagging/finding resources
# run = "true"

[reporter]                        # fixed across cells so report quality is not a confounder
harness = "{reporter}"
# model = "your-model"
# auth = "inherit"

[[cells]]
id = "{harness}-default"
harness = "{harness}"
# model = "your-model"            # or models = ["model-a", "model-b"]: one cell per model
config = "clean"                  # request supported isolation; inspect doctor/report limits; user = normal config
# auth = "inherit"                # or a [auth.*] profile name, or an auth type (ajx plugins)
# environment = "developer"      # named [environments.developer] profile
# agent_configuration = "plain"  # named [agent_configurations.plain] profile
'''

PROMPT_TEMPLATE = '''I want to try {product}.

<Describe the real outcome you want, as a customer would. Name the materials the agent may use
(for example the GitHub README URL). State the boundaries (account/profile/region, spend limit,
what to clean up). Do not mention evaluation, AJX, or expected problems.>
'''


def cmd_init(args):
    plugins.load()
    if args.harness not in plugins.names("harness"):
        raise specmod.SpecError(f"unknown harness {args.harness!r}; run `ajx plugins`")
    reporter_name = args.reporter or (args.harness if plugins.get("harness", args.harness)().can_report else "claude-code")
    if reporter_name not in plugins.names("harness") or not plugins.get("harness", reporter_name)().can_report:
        raise specmod.SpecError(f"{reporter_name!r} has no restricted reporter adapter")
    prompt_bytes = PROMPT_TEMPLATE.format(product=args.product).encode("utf-8")
    if args.task is not None:
        if not args.task.strip():
            raise specmod.SpecError("--task must not be empty")
        prompt_bytes = args.task.encode("utf-8")
    if args.task_file is not None:
        source = Path(args.task_file)
        if not source.is_file():
            raise specmod.SpecError("--task-file must name a readable regular file")
        try:
            prompt_bytes = source.read_bytes()
        except OSError as exc:
            raise specmod.SpecError(f"cannot read --task-file: {exc}") from None
        try:
            nonempty = bool(prompt_bytes.decode("utf-8").strip())
        except UnicodeDecodeError:
            nonempty = False
        if not nonempty:
            raise specmod.SpecError("--task-file must contain nonempty UTF-8 text")
    budget = None
    if args.max_budget_usd is not None:
        try:
            budget = float(args.max_budget_usd)
        except ValueError:
            raise specmod.SpecError("--max-budget-usd must be a finite positive number") from None
        if not math.isfinite(budget) or budget <= 0:
            raise specmod.SpecError("--max-budget-usd must be a finite positive number")
    d = Path(args.dir).resolve()
    d.mkdir(parents=True, exist_ok=True)
    tid = args.id or _trial_id(d.name)
    trial, prompt = d / "trial.toml", d / "task-prompt.md"
    trial_text = TRIAL_TEMPLATE.format(id=tid, product=args.product, harness=args.harness, reporter=reporter_name)
    if budget is not None:
        trial_text = trial_text.replace("# max_budget_usd = 5", f"max_budget_usd = {budget}", 1)
    for path, data in ((trial, trial_text.encode("utf-8")), (prompt, prompt_bytes)):
        if path.exists() and not args.force:
            print(f"exists, not overwritten: {path}")
        else:
            path.write_bytes(data)
            print(f"wrote {path}")
    if args.task_file is not None:
        print(f"task-prompt.md sha256: {hashlib.sha256(prompt.read_bytes()).hexdigest()}")
    print(f"Next: describe the task in task-prompt.md and add a [[verify]] check, then review and start it in the "
          f"browser with: ajx console {consolemod._short(d)}")
    return 0


def _trial_id(name):
    """The folder name lowercased with dashes for spaces when that is a valid trial id; otherwise a
    slug of it (at most 48 characters, cut at a dash), so the scaffold always loads."""
    tid = name.lower().replace(" ", "-")
    if specmod._ID.match(tid):
        return tid
    slug = re.sub(r"[^a-z0-9._]+", "-", name.strip().lower()).lstrip("-._")
    if len(slug) > 48:
        slug = slug[:48]
        cut = slug.rfind("-")
        slug = slug[:cut] if cut >= 24 else slug
    return slug.rstrip("-._") or "my-trial"


def cmd_example(args):
    from ajx.demo import generate
    try:
        output = generate(Path(args.dir).resolve())
    except ValueError as exc:
        print(str(exc), file=sys.stderr)
        return 2
    print(f"Fictional example; no agents or model providers were called.\n{output / 'index.html'}")
    return 0


DOCUMENTATION_TOPICS = {
    "guide": "SKILL.md",
    "trial": "examples/trial.toml",
    "briefing": "references/briefing.md",
    "environments": "references/environments.md",
    "console": "references/console.md",
    "checks": "references/headless.md",
    "reporting": "references/reporting.md",
    "artifacts": "references/artifacts.md",
    "measurement": "references/measurement.md",
}


def cmd_docs(args):
    if not args.topic:
        for topic, path in DOCUMENTATION_TOPICS.items():
            print(f"ajx docs {topic:12s} {path}")
        print("Documents come from this CLI's bundled skill. Public quickstart: https://ajx.dev/agents/")
        return 0
    path = Path(__file__).resolve().parents[1] / DOCUMENTATION_TOPICS[args.topic]
    print(path.read_text(encoding="utf-8"), end="")
    return 0


def cmd_plugins(args):
    plugins.load()
    for kind in plugins.KINDS:
        print(f"{kind}:")
        for name in plugins.names(kind):
            cls = plugins.get(kind, name)
            extra = ""
            if kind == "harness":
                h = cls()
                extra = (f"  installed={'yes' if h.available() else 'no'} verified_live={h.verified_live} "
                         f"resume={h.can_resume} reporter={h.can_report} clean={h.clean_supported} default_auth={h.default_auth}")
            if kind == "auth":
                extra = f"  for={','.join(cls.harnesses)}  {cls.description}"
            print(f"  {name:22s}{extra}")
    return 0


def cmd_doctor(args):
    spec = specmod.load(args.trial) if args.trial else None
    plugins.load(Path(spec["path"]).parent if spec else None)
    print(f"python {sys.version.split()[0]}")
    names = specmod.harness_names(spec) if spec else plugins.names("harness")
    wanted = {c["harness"] for c in spec["cells"]} | {spec["reporter"]["harness"]} if spec else set(names)
    host_required = ({spec["reporter"]["harness"]} | {
        c["harness"] for c in spec["cells"]
        if (specmod.environment_for(spec, c) or {}).get("backend") != "container"
    }) if spec else wanted
    ok = True
    for name in names:
        if name not in wanted:
            continue
        if name not in host_required:
            print(f"harness {name:14s} availability will be checked inside the selected container during prepare")
            continue
        h = specmod.harness_for(spec, name) if spec else plugins.get("harness", name)()
        avail = h.available()
        print(f"harness {name:14s} installed={'yes' if avail else 'NO '} version={h.version() or 'n/a'} "
              f"verified_live={h.verified_live} resume={h.can_resume} clean={h.clean_supported} telemetry: {h.telemetry}")
        ok &= avail
    if spec:
        for warning in envcheck.shell_syntax_warnings(spec):
            print(f"    WARNING {warning}")
        with tempfile.TemporaryDirectory() as tmp:
            ok &= _doctor_cells(spec, Path(tmp))
        for cmd in spec["verify"]:
            print(f"verify  {cmd['type']:10s} {cmd['name']}")
        print(f"workspace_root={spec['trial']['workspace_root']} output_dir={spec['trial']['output_dir']}")
        print("Review the declared permissions and TASK identity before running. Model authentication and "
              "task access are separate. Environment profiles report which restrictions are enforced.")
    print("READY: the checked prerequisites passed. Run only within the authorized scope." if ok else
          "NOT READY: fix the FAILED/PROBLEMS or missing harnesses above before `ajx run`.")
    return 0 if ok else 1


def _doctor_cells(spec, tmp):
    """Per cell: model credentials, the worker's tool-shell identity and env warnings; then, per distinct
    verify/teardown environment, the same identity under /bin/sh and the [[preflight]] results."""
    ok, memo, groups = True, {}, {}
    rep = spec["reporter"]
    reporter_auth = specmod.auth_for(spec, {"id": "reporter", "harness": rep["harness"], "auth": rep.get("auth")})
    print(f"reporter harness={rep['harness']} model={rep.get('model') or 'harness default'} auth={reporter_auth.profile}")
    reporter_problems = reporter_auth.problems()
    if reporter_problems:
        print(f"    PROBLEMS: {reporter_problems}")
        ok = False
    ident_cmd = spec["task"].get("identity_cmd")
    ws = envcheck.scratch_workspace(spec, tmp)

    def once(key, fn):
        if key not in memo:
            memo[key] = fn()
        return memo[key]

    def sig(env):
        return tuple(sorted(env.items()))

    for cell in spec["cells"]:
        harness = specmod.harness_for(spec, cell["harness"])
        auth = specmod.auth_for(spec, cell)
        rn = specmod.runner_for(spec, cell)
        probs = auth.problems()
        profile = specmod.environment_for(spec, cell)
        if profile:
            print(f"cell {cell['id']:16s} harness={cell['harness']} model={cell.get('model') or 'harness default'}")
            print(f"    environment={cell.get('environment') or 'ajx-local'} backend={profile['backend']} "
                  f"agent_configuration={cell.get('agent_configuration') or 'legacy clean settings'}")
            backend_check = rn.doctor({"spec": spec, "cell": cell})
            healthy = backend_check.get("status") == "available"
            print("    backend prerequisites: " + ("available" if healthy else "FAILED"))
            probe = backend_check.get("mount_probe") or {}
            if probe.get("status") == "ok":
                print(f"    workspace bind-mount probe: ok ({probe.get('workspace_root')})")
            elif probe.get("status") == "skipped":
                print(f"    workspace bind-mount probe: skipped ({probe.get('reason')})")
            elif probe:
                print(f"    workspace bind-mount probe: FAILED ({probe.get('workspace_root')})")
            if backend_check.get("error"):
                print(f"    {backend_check['error']}")
            ok &= healthy
            if probs:
                print(f"    PROBLEMS: {probs}")
                ok = False
            print("    Profile schema and adapter controls validated. Runtime inventory, permissions, and "
                  "environment-located preflight commands are checked during prepare.")
            print("    Setup/teardown use their declared location; verification defaults to the host.")
            continue
        ctx = envcheck.placeholder_ctx(spec, cell, auth, rn, tmp)
        checks, view = envcheck.inspect_cell(spec, cell, harness, auth, rn, ws, ctx)
        eff = view["effective"]
        checks["auth_identity"] = once(("auth", auth.profile, sig(eff)), lambda: envcheck.auth_identity(auth, eff))
        print(f"cell {cell['id']:16s} harness={cell['harness']} model={cell.get('model') or 'harness default'} "
              f"config={cell['config']}")
        print(f"    auth={auth.profile} ({auth.name}) env={sorted(auth.env())} unset={auth.unset()} "
              f"isolates_config={auth.isolates_config}")
        for label, key in (("configuration", "configuration"), ("shell startup", "shell_startup")):
            note = (checks.get(key) or {}).get("note")
            if note:
                print(f"    {label}: {note}")
        for s in checks["harness_settings"]:
            print(f"    harness settings env applied over the worker env: {s['source']} sets {', '.join(s['names'])}")
        print(f"    harness auth identity (model credentials): {checks['auth_identity'] or 'n/a'}")
        if checks["auth_identity"] and envcheck.auth_error_lines(checks["auth_identity"]):
            print("    FAILED the model credentials above do not authenticate; every model call would fail")
            ok = False
        checks["task_identity"] = None
        if ident_cmd and checks["local_runner"]:
            checks["task_identity"] = once(("tool", ident_cmd, view["shell"], sig(eff)),
                                           lambda: envcheck.identity_result(ident_cmd, ws, eff, view["shell"]))
            label = f"task identity (worker tool shell, {checks['tool_shell']}): "
            if checks["task_identity"]["ok"]:
                print(f"    {label}{checks['task_identity']['output']}")
            else:
                print(f"    {label}FAILED ({_why(checks['task_identity'])}): {checks['task_identity']['output']}")
                ok = False
        elif ident_cmd:
            print(f"    task identity: not checked here (runner {rn.name} runs the worker elsewhere)")
        else:
            print("    task identity: not checked ([task] identity_cmd unset; set it for any task that uses an account)")
        checks["default_aws_identity"] = None
        checks["aws_profile_source"] = None
        if checks["local_runner"]:
            checks["aws_profile_source"] = next(
                (source for name in ("AWS_PROFILE", "AWS_DEFAULT_PROFILE")
                 if (source := envcheck.startup_source(name, eff))), None)
        if checks["local_runner"] and envcheck.uses_aws(spec, auth, view):
            checks["default_aws_identity"] = once(
                ("tool", envcheck.DEFAULT_AWS_IDENTITY, view["shell"], sig(eff)),
                lambda: envcheck.identity_result(envcheck.DEFAULT_AWS_IDENTITY, ws, eff, view["shell"]))
            d = checks["default_aws_identity"]
            print("    default AWS identity in the agent's tool shell (any aws/SDK call without --profile): "
                  + (d["output"] if d["ok"] else f"none ({_why(d)}: {d['output']})"))
        for w in envcheck.warnings(checks, auth, view) + [envcheck.default_identity_warning(checks)]:
            if w:
                print(f"    WARNING {w}")
        if probs:
            print(f"    PROBLEMS: {probs}")
            ok = False
        print(f"    runner={rn.name} {rn.describe()}")
        env = envcheck.command_env(specmod.worker_env(spec, cell, auth), auth.unset(), "doctor", spec)
        groups.setdefault(sig(env), {"env": env, "cells": [], "tool": []})
        groups[sig(env)]["cells"].append(cell["id"])
        groups[sig(env)]["tool"].append(checks["task_identity"])
    if not (ident_cmd or spec["preflight"]):
        return ok
    for group in groups.values():
        print(f"verify/teardown/preflight shell (/bin/sh -c, ajx env only; no harness settings, no shell startup "
              f"files) for cells {', '.join(group['cells'])}")
        if ident_cmd:
            res = envcheck.identity_result(ident_cmd, ws, group["env"])
            if not res["ok"]:
                print(f"    task identity: FAILED ({_why(res)}): {res['output']}")
                ok = False
            else:
                differs = [t for t in group["tool"] if t and t["ok"] and t["output"] != res["output"]]
                print(f"    task identity: {res['output']}")
                if differs:
                    print("    WARNING this differs from the worker's tool shell identity: verify and teardown act as a "
                          "different identity than the agent and may not see what it created")
        for rec in envcheck.run_preflight(spec["preflight"], ws, group["env"]):
            print(f"    preflight {rec['name']}: " + ("ok" if rec["passed"] else f"FAILED ({envcheck.preflight_failure(rec)})"))
            ok &= rec["passed"]
    return ok


def _why(res):
    if res["timed_out"]:
        return "timed out"
    return f"exit {res['exit_code']}" if res["exit_code"] != 0 else "credential errors in its output"


def cmd_validate(args):
    spec = specmod.load(args.trial)
    plan = specmod.run_plan(spec, _cells(args))
    print(f"trial {spec['trial']['id']} product={spec['trial']['product']} trial_sha256={spec['sha256'][:16]}")
    print(f"prompt {spec['task']['prompt_path']} sha256={spec['task']['prompt_sha256']}")
    print(f"cells={len(spec['cells'])} repetitions={spec['trial']['repetitions']} runs={len(plan)} parallel={spec['trial']['parallel']}")
    for c, r in plan:
        print(f"  {c['id']}-r{r}: {c['harness']} model={c.get('model') or 'harness default'} config={c['config']} "
              f"auth={c.get('auth') or 'default'}"
              + (f" environment={c.get('environment') or 'ajx-local'} "
                 f"agent_configuration={c.get('agent_configuration') or 'legacy'}"
                 if specmod.environment_for(spec, c) else ""))
    print(f"verify checks={len(spec['verify'])} setup={len(spec['setup'])} teardown={len(spec['teardown'])} "
          f"preflight={len(spec['preflight'])} task identity_cmd={'set' if spec['task'].get('identity_cmd') else 'unset'}")
    print(f"output_dir={spec['trial']['output_dir']}")
    for warning in envcheck.shell_syntax_warnings(spec):
        print(f"WARNING {warning}")
    wanted = {c["id"] for c, _ in plan}
    with tempfile.TemporaryDirectory() as tmp:  # probes the agent's tool shell; runs no identity commands
        ws = envcheck.scratch_workspace(spec, tmp)
        for cell in (c for c in spec["cells"] if c["id"] in wanted):
            if specmod.environment_for(spec, cell):
                print(f"PROFILE {cell['id']}: configuration validated; actual environment checks run during prepare")
                continue
            auth, rn = specmod.auth_for(spec, cell), specmod.runner_for(spec, cell)
            checks, view = envcheck.inspect_cell(spec, cell, specmod.harness_for(spec, cell["harness"]), auth, rn, ws,
                                                 envcheck.placeholder_ctx(spec, cell, auth, rn, tmp))
            for w in envcheck.warnings(checks, auth, view):
                print(f"WARNING {cell['id']}: {w}")
    return 0


def _cells(args):
    return [c.strip() for c in args.cells.split(",")] if getattr(args, "cells", None) else None


def _interrupt(signum, frame):
    raise KeyboardInterrupt(f"signal {signum}")


def _hangup(signum, frame):
    # The terminal is gone: keep cleanup output from failing on it.
    devnull = os.open(os.devnull, os.O_WRONLY)
    os.dup2(devnull, 1)
    os.dup2(devnull, 2)
    raise KeyboardInterrupt(f"signal {signum}")


def cmd_run(args):
    previous = {}
    if threading.current_thread() is threading.main_thread():
        # A launcher can leave SIGINT ignored (a background job of a non-interactive shell), and SIGTERM or
        # SIGHUP would end the process without the handled interruption that stops the worker, tears
        # down, releases the environment and purges copied credentials.
        for sig, handler in ((signal.SIGINT, signal.default_int_handler), (signal.SIGTERM, _interrupt),
                             (signal.SIGHUP, _hangup)):
            previous[sig] = signal.signal(sig, handler)
    try:
        return _run(args)
    finally:
        for sig, handler in previous.items():
            signal.signal(sig, handler)


def _run(args):
    stages = [s.strip() for s in args.stages.split(",")] if args.stages else None
    spec = specmod.load(args.trial, cleanup_only=runner.cleanup_only(stages))
    expected = getattr(args, "expect_plan", None)
    if expected and consolemod.plan_sha(spec["path"], spec) != expected:
        raise specmod.SpecError("the trial changed after it was approved (trial.toml, the task prompt, the starting "
                                "files or the trial's plugins); review it and approve it again")
    log = lambda m: print(f"[{__import__('datetime').datetime.now().strftime('%H:%M:%S')}] {m}", flush=True)  # noqa: E731
    meta = runner.run_matrix(spec, only_cells=_cells(args), stages=stages, keep_workspace=args.keep_workspace,
                             log=log, dry_run=args.dry_run, synthesize=not args.no_synthesis)
    if args.dry_run:
        print(json.dumps(meta, indent=2))
        return 0
    out = Path(spec["trial"]["output_dir"])
    print(f"\nmatrix report: {out / 'index.html'}\nmarkdown:      {out / 'matrix.md'}")
    return cmd_status(argparse.Namespace(trial=str(out)))


def cmd_status(args):
    path = Path(args.trial)
    spec = specmod.load(path, cleanup_only=True) if path.is_file() else None
    out = Path(spec["trial"]["output_dir"]) if spec else path
    runs = sorted((out / "runs").iterdir()) if (out / "runs").exists() else []
    print(f"{'run':20s} " + " ".join(f"{s[:7]:>7s}" for s in runner.STAGES) + "  verified")
    bad, cleanup, states = 0, [], []
    for d in runs:
        st = read_json(d / "state.json", {"stages": {}})
        states.append((d, st))
        marks = []
        for s in runner.STAGES:
            v = st["stages"].get(s, {}).get("status")
            mark = {"done": "ok", "error": "ERR", "running": "run", "interrupted": "INT", None: "-"}.get(v, v or "-")
            # "ran" is not "cleaned up": a teardown that failed or could not authenticate is not ok
            td = (st.get("teardown") or {}).get("status")
            if s == "teardown" and v == "done" and td in TEARDOWN_MARKS:
                mark = TEARDOWN_MARKS[td]
                cleanup.append(f"{d.name}: {render.TEARDOWN_PROBLEMS[td]}; see {d / 'teardown.json'}")
            marks.append(mark)
            bad += v == "error" or mark in TEARDOWN_MARKS.values()
        verify = read_json(d / "verify.json", {})
        verified = verify.get("outcome") or read_json(d / "run.json", {}).get("task_outcome_verified") or ""
        if verify.get("checks_with_auth_errors"):
            verified += f" ({len(verify['checks_with_auth_errors'])} check(s) hit credential errors)"
        print(f"{d.name:20s} " + " ".join(f"{m:>7s}" for m in marks) + f"  {verified}")
        for active in _active_stages(st):
            elapsed = active["elapsed_seconds"]
            elapsed = f"{elapsed:.1f}s" if elapsed is not None else "unknown"
            print(f"  {active['stage']}: started {active['started_at'] or 'unknown'}; elapsed {elapsed}"
                  " (stage marker age; process liveness unverified)")
    for line in cleanup:
        print(f"CLEANUP NOT CONFIRMED {line}")
    if cleanup:
        print("Resources the task created may still exist. After fixing credentials: "
              "ajx run <trial> --cells <cell> --stages teardown,render")
    tail = getattr(args, "tail", None) or 0   # `run` calls cmd_status without the option
    if tail > 0:
        _status_tail(spec, states, tail)
    return 1 if bad else 0


TEARDOWN_MARKS = {"auth_errors": "AUTH", "failed": "FAIL", "skipped": "SKIP"}


def _active_stages(state):
    """Adapter-independent marker age, not model progress or a completion estimate."""
    from datetime import datetime
    active = []
    for stage in runner.STAGES:
        record = (state.get("stages") or {}).get(stage) or {}
        if record.get("status") != "running":
            continue
        start = record.get("started_at") or record.get("at")
        elapsed = None
        try:
            at = parse_ts(start)
            seconds = (datetime.now(at.tzinfo) - at).total_seconds()
            if seconds >= 0:
                elapsed = round(seconds, 3)
        except (AttributeError, TypeError, ValueError, OverflowError):
            pass
        active.append({"stage": stage, "started_at": start, "elapsed_seconds": elapsed})
    return active


def _status_tail(spec, states, limit):
    """After the table: the last `limit` worker events (Harness.progress) of each run still executing,
    or of every run when none is. A feed that is missing or unreadable is a note, never a failure."""
    running = [(d, st) for d, st in states
               if ((st.get("stages") or {}).get("execute") or {}).get("status") == "running"]
    for d, st in running or states:
        print(f"\n{d.name}: last {limit} worker events (execute)")
        harness, why = _run_harness(spec, d)
        if harness is None:
            print(f"  ({why})")
            continue
        progress = getattr(harness, "progress", None)
        if progress is None:
            print(f"  ({getattr(harness, 'name', type(harness).__name__)} does not report progress)")
            continue
        try:
            events = list(progress(d, "execute", limit) or [])[-limit:]
        except Exception as exc:  # noqa: BLE001 - a status feed must never take status down
            print(f"  (progress unavailable: {type(exc).__name__}: {exc})")
            continue
        if not events:
            print("  (no worker events recorded)")
        for ev in events:
            ev = ev if isinstance(ev, dict) else {"text": ev}
            print(f"  {_clock(ev.get('at'))} {str(ev.get('kind') or '')[:5]:5s} {_one_line(ev.get('text'))}")


def _run_harness(spec, run_dir):
    """The run's harness adapter: the trial cell's when a trial file was given, else the name the run
    recorded (run.json after render, environment.json from prepare). (None, reason) when unavailable."""
    name = None
    try:
        if spec:
            for cell in spec["cells"]:
                prefix = f"{cell['id']}-r"
                if run_dir.name.startswith(prefix) and run_dir.name[len(prefix):].isdigit():
                    return specmod.harness_for(spec, cell["harness"]), None
        name = (((read_json(run_dir / "run.json", {}) or {}).get("agent") or {}).get("harness_name")
                or ((read_json(run_dir / "environment.json", {}) or {}).get("harness") or {}).get("name"))
        if not name:
            return None, "harness unknown: no trial cell matches this run and it records no harness yet"
        return plugins.get("harness", name)(), None
    except Exception as exc:  # noqa: BLE001 - status must not fail on a half-written or odd run dir
        return None, f"harness {name!r} unavailable: {type(exc).__name__}: {exc}"


def _clock(at):
    """HH:MM:SS (local time) for an ISO timestamp; --:--:-- when the adapter has none."""
    try:
        return parse_ts(str(at)).astimezone().strftime("%H:%M:%S") if at else "--:--:--"
    except ValueError:
        return "--:--:--"


def _one_line(text, limit=200):
    text = " ".join(str(text if text is not None else "").split())
    return text if len(text) <= limit else text[:limit - 3] + "..."


def cmd_export(args):
    path = Path(args.trial)
    out = Path(specmod.load(path, cleanup_only=True)["trial"]["output_dir"]) if path.is_file() else path
    run_id = args.run
    if not run_id or Path(run_id).name != run_id or run_id in (".", ".."):
        return _fail(f"export: --run takes a run id such as my-cell-r1, not {run_id!r}")
    run_dir = out / "runs" / run_id
    if not run_dir.is_dir():
        known = sorted(p.name for p in (out / "runs").iterdir() if p.is_dir()) if (out / "runs").is_dir() else []
        return _fail(f"export: run {run_id!r} not found in {out / 'runs'}"
                     + (f"; runs: {', '.join(known)}" if known else "; no runs recorded there"))
    dest = Path(args.dest).expanduser() if args.dest else out / "share" / run_id
    if dest.resolve() == run_dir.resolve():
        return _fail(f"export: --dest must not be the run directory itself ({run_dir})")
    if dest.is_dir() and any(dest.iterdir()) and not args.force:
        return _fail(f"export: {dest} is not empty; pass --force to overwrite its report.html, journey.html and asks.md")
    try:
        summary = exportmod.export_run(run_dir, dest)
    except (exportmod.ExportError, OSError) as exc:
        return _fail(f"export: {exc}")
    print(summary["dest"])
    for name in summary["files"]:
        print(f"  {name}")
    counts = summary["replacements"]
    print("replacements: " + (", ".join(f"{n} x {label}" for label, n in counts.items()) or "none"))
    for note in summary.get("warnings") or []:
        print(f"note: {note}")
    print("Review before sharing: exported reports still contain the agent's commands and outputs, "
          "account identifiers, and URLs.")
    return 0


def _fail(message):
    print(message, file=sys.stderr)
    return 1


def cmd_report(args):
    spec = specmod.load(args.trial)
    out = Path(spec["trial"]["output_dir"])
    for d in sorted((out / "runs").iterdir()) if (out / "runs").exists() else []:
        if (d / "run.json").exists():
            render.run_report(d)
    render.matrix_report(spec, synthesize=not args.no_synthesis)
    print(f"{out / 'index.html'}")
    return 0


CONSOLE_ACTIONS = ("open", "serve", "stop", "list", "state", "since", "wait", "note", "start", "again", "demo")


def _dump(data):
    print(json.dumps(data, indent=2, ensure_ascii=False))
    return 0


def _console_open(trial, args):
    if getattr(args, "foreground", False):
        return consolemod.serve(trial, port=args.port, open_browser=not args.no_open,
                                announce=lambda url: print(f"AJX Console: {url}\nPress Ctrl-C to stop it; runs keep going."))
    info = consolemod.open_console(trial, port=getattr(args, "port", 0), open_browser=not args.no_open)
    where = consolemod._short(consolemod.trial_file(trial).parent)
    print(f"AJX Console: {info['url']}")
    print(("Started" if info.get("started") else "Already running") + f" in the background (pid {info['pid']}); "
          f"it stops after 30 idle minutes or with: ajx console stop {where}")
    print("Closing the page, this terminal or the chat never stops a run.")
    print(f"Agents catch up with: ajx console since {where} --cursor 0")
    others = [c for c in consolemod.list_consoles() if c["pid"] != info["pid"]]
    if others:
        print(f"{len(others)} other console(s) running: ajx console list (ajx console stop --all stops them)")
    return 0


def cmd_console(args):
    act = args.action
    if act == "demo":
        trial = consolemod.copy_demo(args.dir, force=args.force)
        print(f"Copied the console demo to {consolemod._short(trial.parent)}. Its worker is simulated: "
              "no agent, model or network is used.")
        return _console_open(trial, args)
    if act == "open":
        return _console_open(args.trial, args)
    if act == "serve":
        return consolemod.serve(args.trial, port=args.port, open_browser=args.open,
                                announce=lambda url: print(f"serving {url}", flush=True))
    if act == "stop":
        if args.trial == "all" and not Path("all").exists():
            args.all = True
        if args.all:
            count = consolemod.stop_all()
            print(f"stopped {count} console(s); runs keep going" if count else "no console was running")
            return 0
        if not args.trial:
            running = consolemod.list_consoles()
            return _fail("console stop: name a trial, or stop every console with: ajx console stop --all"
                         + (f" ({len(running)} running; see ajx console list)" if running else " (none is running)"))
        print("console stopped; runs keep going" if consolemod.stop_console(args.trial)
              else "no console was running for this trial")
        return 0
    if act == "list":
        consoles = consolemod.list_consoles()
        if args.json:
            return _dump(consoles)
        if not consoles:
            print("no console is running")
            return 0
        for c in consoles:
            print(f"pid {c['pid']:>7}  up {c['elapsed']:>9}  {c['short']}\n    {c['url'] or '(starting or unreachable)'}")
        print("Stop one with: ajx console stop <trial>; all with: ajx console stop --all (runs keep going)")
        return 0
    if act == "state":
        return _dump(consolemod.snapshot(args.trial))
    if act == "since":
        return _dump(consolemod.since(args.trial, args.cursor))
    if act == "wait":
        return _dump(consolemod.wait(args.trial, args.cursor, args.timeout))
    if act == "note":
        entry = consolemod.note(args.trial, args.text, reply_to=args.reply_to)
        where = "on the console's Activity tab" if consolemod.server_info(args.trial) else \
            "in the journal; the console is not running, so the user sees it when it is opened again"
        print(f"posted note #{entry['n']}" + (f" replying to #{args.reply_to}" if args.reply_to else "") + f" {where}")
        return 0
    if act == "start":
        consolemod.preflight_start(args.trial, args.plan)
        print("checking readiness (ajx validate, then ajx doctor) for this plan...", flush=True)
        entry = consolemod.start(args.trial, actor="agent", via="chat", plan=args.plan, quote=args.quote,
                                 accept_warnings=args.accept_warnings)
        print(f"started {entry['command']} (pid {entry['pid']}); the console shows it live, and "
              f"`ajx console wait` returns when it changes")
        return 0
    if act == "again":
        mode = "same-folder" if args.same_folder else "fresh-folder"
        print(f"run again ({mode}): checking readiness (ajx validate, then ajx doctor)...", flush=True)
        entry = consolemod.run_again(args.trial, actor="agent", via="chat", mode=mode, plan=args.plan,
                                     quote=args.quote, accept_warnings=args.accept_warnings)
        print(f"started {entry['command']} (pid {entry['pid']}); earlier attempts are kept as they were")
        return 0
    return 2


def main(argv=None):
    p = argparse.ArgumentParser(prog="ajx", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument("--version", action="version", version=f"AJX {__version__}")
    sub = p.add_subparsers(dest="cmd", required=True)
    s = sub.add_parser("init"); s.add_argument("dir"); s.add_argument("--product", required=True); s.add_argument("--id"); s.add_argument("--force", action="store_true")
    s.add_argument("--harness", default="claude-code"); s.add_argument("--reporter"); s.set_defaults(fn=cmd_init)
    task_input = s.add_mutually_exclusive_group()
    task_input.add_argument("--task", metavar="TEXT", help="complete worker prompt, written verbatim into task-prompt.md")
    task_input.add_argument("--task-file", metavar="FILE", help="copy a UTF-8 worker prompt without changing its bytes")
    s.add_argument("--max-budget-usd", metavar="USD", help="positive worker budget; enforcement depends on the harness, excluding reporting calls")
    s = sub.add_parser("example"); s.add_argument("dir"); s.set_defaults(fn=cmd_example)
    s = sub.add_parser("docs", help="read bundled documentation without network access")
    s.add_argument("topic", nargs="?", choices=DOCUMENTATION_TOPICS); s.set_defaults(fn=cmd_docs)
    s = sub.add_parser("plugins"); s.set_defaults(fn=cmd_plugins)
    s = sub.add_parser("doctor"); s.add_argument("trial", nargs="?"); s.set_defaults(fn=cmd_doctor)
    s = sub.add_parser("validate"); s.add_argument("trial"); s.add_argument("--cells"); s.set_defaults(fn=cmd_validate)
    s = sub.add_parser("run"); s.add_argument("trial"); s.add_argument("--cells"); s.add_argument("--stages")
    s.add_argument("--dry-run", action="store_true"); s.add_argument("--keep-workspace", action="store_true")
    s.add_argument("--no-synthesis", action="store_true")
    s.add_argument("--expect-plan", metavar="SHA", help="refuse to start unless the trial still matches this approved "
                   "plan id (set by `ajx console`)")
    s.set_defaults(fn=cmd_run)
    s = sub.add_parser("status"); s.add_argument("trial")
    s.add_argument("--tail", type=int, metavar="N",
                   help="after the table, the last N worker events of each run still executing (of every run when none is)")
    s.set_defaults(fn=cmd_status)
    s = sub.add_parser("report"); s.add_argument("trial"); s.add_argument("--no-synthesis", action="store_true"); s.set_defaults(fn=cmd_report)
    s = sub.add_parser("export"); s.add_argument("trial")
    s.add_argument("--run", required=True, metavar="RUN_ID", help="run id, for example my-cell-r1")
    s.add_argument("--dest", metavar="DIR", help="default <output>/share/<run-id>")
    s.add_argument("--force", action="store_true", help="overwrite the files in a non-empty --dest")
    s.set_defaults(fn=cmd_export)
    s = sub.add_parser("console", help="local web page for a trial; see `ajx console --help`")
    acts = s.add_subparsers(dest="action", required=True)
    c = acts.add_parser("open", help="open (or reuse) this trial's console; the server runs in the background")
    c.add_argument("trial", help="trial.toml or the directory holding it")
    c.add_argument("--port", type=int, default=0, help="default: a free port")
    c.add_argument("--no-open", action="store_true", help="print the link without opening a browser")
    c.add_argument("--foreground", action="store_true", help="serve in this terminal until Ctrl-C")
    c = acts.add_parser("demo", help="copy a simulated trial (no agent or model) into DIR and open it")
    c.add_argument("dir"); c.add_argument("--force", action="store_true"); c.add_argument("--no-open", action="store_true")
    c.add_argument("--port", type=int, default=0)
    c = acts.add_parser("serve", help="internal: serve in this process (`open` starts it in the background)")
    c.add_argument("trial"); c.add_argument("--port", type=int, default=0); c.add_argument("--open", action="store_true")
    c = acts.add_parser("stop", help="stop this trial's console server, or every one with --all (never a run)",
                        description="Stop console servers. Runs keep going; reopen a console with `ajx console open`.")
    c.add_argument("trial", nargs="?", help="trial.toml or its directory; `all` is the same as --all")
    c.add_argument("--all", action="store_true", help="stop every console server running for you")
    c = acts.add_parser("list", help="console servers running for you"); c.add_argument("--json", action="store_true")
    c = acts.add_parser("state", help="everything the page shows, as JSON"); c.add_argument("trial")
    c = acts.add_parser("since", help="for agents: what changed after --cursor, as JSON")
    c.add_argument("trial"); c.add_argument("--cursor", type=int, default=0)
    c = acts.add_parser("wait", help="for agents: block until something changes, then print `since`")
    c.add_argument("trial"); c.add_argument("--cursor", type=int, default=0)
    c.add_argument("--timeout", type=int, default=90, help="seconds (default 90; keep under your tool-call limit)")
    c = acts.add_parser("note", help="for agents: post a short explanation to the page's activity list")
    c.add_argument("trial"); c.add_argument("text"); c.add_argument("--reply-to", type=int, metavar="N")
    c = acts.add_parser("start", help="for agents: start after the user approved in chat (check, approve, launch)")
    c.add_argument("trial"); c.add_argument("--quote", required=True, help="the user's approval, word for word")
    c.add_argument("--plan", required=True, help="plan id from `since` (its first 7+ characters); refuses a plan "
                   "that changed after the user saw it")
    c.add_argument("--accept-warnings", action="store_true",
                   help="only when the user accepted the readiness warnings listed by `since`, in their own words")
    c = acts.add_parser("again", help="for agents: run a finished trial again after the user asked (new attempt)")
    c.add_argument("trial"); c.add_argument("--quote", required=True, help="the user's request, word for word")
    c.add_argument("--plan", required=True, help="plan id from `since`; refuses a plan that changed meanwhile")
    where = c.add_mutually_exclusive_group(required=True)
    where.add_argument("--same-folder", action="store_true",
                       help="one more attempt in this output folder, same settings (results stay comparable)")
    where.add_argument("--fresh-folder", action="store_true", help="a new, empty output folder (changed settings)")
    c.add_argument("--accept-warnings", action="store_true",
                   help="only when the user accepted the readiness warnings listed by `since`, in their own words")
    s.set_defaults(fn=cmd_console)
    argv = list(sys.argv[1:] if argv is None else argv)
    if len(argv) >= 2 and argv[0] == "console" and argv[1] not in CONSOLE_ACTIONS and not argv[1].startswith("-"):
        argv.insert(1, "open")   # `ajx console trials/x` opens the console
    args = p.parse_args(argv)
    try:
        return args.fn(args)
    except specmod.SpecError as exc:
        print(f"trial file error: {exc}", file=sys.stderr)
        return 2
    except consolemod.ConsoleError as exc:
        print(f"console: {exc}", file=sys.stderr)
        return 2
    except runner.LockedError as exc:
        print(f"locked: {exc}", file=sys.stderr)
        return 3
    except KeyboardInterrupt:
        print("ajx: interrupted. Captured evidence is kept; rerun the same command to finish the remaining "
              "stages.", file=sys.stderr)
        return 130


if __name__ == "__main__":
    sys.exit(main())
